# 复制本文件为 .env，填上你自己的 key（.env 已在 .gitignore，不会提交）
# /rag/search 带 "with_answer": true 时生效

# 方式一（最简单）：只要一个 DeepSeek key，base_url 和模型名自动回落默认
DEEPSEEK_API_KEY=sk-你的key

# 方式二：自定义 OpenAI 兼容接口（覆盖默认 DeepSeek 配置）
# RAG_LLM_BASE_URL=https://api.deepseek.com
# RAG_LLM_API_KEY=sk-你的key
# RAG_LLM_MODEL=deepseek-chat

# pageindex 文档检索（/pageindex）：与 /rag 共用上面同一个 DeepSeek key
# （DEEPSEEK_API_KEY 优先，缺省回落 RAG_LLM_API_KEY）。可选覆盖模型：
# PAGEINDEX_MODEL=deepseek/deepseek-chat        # litellm 写法（provider/model）
# PAGEINDEX_SUMMARY_MODEL=deepseek/deepseek-chat
