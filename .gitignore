# Python-generated files
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/

# 锁文件不入库（每次 uv sync 重新解析）
uv.lock

# 本地密钥（含 API key，不入库）
.env
build/
dist/
wheels/
*.egg-info

# IDE
.idea/

# Virtual environments
.venv

# Jupyter
.ipynb_checkpoints/

# 数据（体积大，不入库，保留目录结构）
/data/raw/*
/data/processed/*
/data/splits/*
/data/rag_index/*
/data/pageindex/*
!/data/**/.gitkeep

# 训练产物（模型、日志、指标）
/models/*
!/models/.gitkeep
/outputs/*
!/outputs/.gitkeep

# MCP 预测日志（hook 运行时生成，不入库）
logs/

# Claude Code 本地设置（个人权限/hook，不入库）
.claude/settings.local.json

# 本地 BERT 模型权重（约 400MB，不入库）
/assets/models/

# Week06 课程资源
/assets/Week06/
